APP_NAME=Docsnary API
APP_ENV=development
APP_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg://docsnary:your_database_password@localhost:5432/docsnary

REDIS_URL=redis://localhost:6379

STORAGE_ROOT=storage

AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=

# AI_PROVIDER options: mock (default) | deterministic | openai | anthropic | gemini
# AI_MODEL examples: gpt-4o-mini (openai) | claude-sonnet-5 (anthropic) | gemini-2.5-flash (gemini)

EMBEDDING_PROVIDER=
# EMBEDDING_PROVIDER options: mock (default) | openai
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS must match the chunks.embedding column -- changing it
# requires the c4a8f0e1d6b2 migration and re-embedding (scripts/reembed_chunks.py)
EMBEDDING_DIMENSIONS=32